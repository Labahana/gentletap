# Example nginx config for https://gentletap.co
# Proxy ALL paths (including /v1/*) to the Next.js web container.
# Next.js forwards /v1/* to the API container internally.
#
# After editing, reload: sudo nginx -t && sudo systemctl reload nginx
# Also set in /etc/nginx/nginx.conf (http block): server_tokens off;

# Rate limit abusive clients at the edge (tune for your traffic).
limit_req_zone $binary_remote_addr zone=gentletap_web:10m rate=30r/s;

server {
    listen 80;
    server_name gentletap.co www.gentletap.co;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name gentletap.co www.gentletap.co;

    # ssl_certificate /etc/letsencrypt/live/gentletap.co/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/gentletap.co/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # HSTS — enable only after HTTPS is verified end-to-end (includeSubDomains optional).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Defense in depth (Next.js also sets these; nginx covers redirects/errors).
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; upgrade-insecure-requests" always;

    location / {
        limit_req zone=gentletap_web burst=60 nodelay;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Hide upstream stack fingerprints.
        proxy_hide_header X-Powered-By;
    }
}

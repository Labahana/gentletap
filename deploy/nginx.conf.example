# Example nginx config for https://gentletap.co
# Proxy ALL paths (including /v1/*) to the Next.js web container.
# Next.js forwards /v1/* to the API container internally.

server {
    listen 80;
    server_name gentletap.co www.gentletap.co;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name gentletap.co www.gentletap.co;

    # ssl_certificate /etc/letsencrypt/live/gentletap.co/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/gentletap.co/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# ─── App (public URLs — use https:// when TLS is enabled) ───────────────────
ENVIRONMENT=production
API_URL=https://gentletap.co
WEB_URL=https://gentletap.co
CORS_ORIGINS=https://gentletap.co
SECRET_KEY=change-me-use-openssl-rand-hex-32
TOKEN_ENCRYPTION_KEY=change-me-32-byte-base64-fernet-key

# ─── Database (Supabase Postgres — production) ─────────────────────────────
# API runtime: use Supabase Transaction pooler (port 6543):
# DATABASE_URL=postgresql+psycopg2://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Alembic migrations: use Direct connection (port 5432) — session mode required:
# DATABASE_MIGRATIONS_URL=postgresql+psycopg2://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
# Local dev (docker-compose.dev.yml): auto-set to postgres:5432

# ─── Redis ─────────────────────────────────────────────────────────────────
# Production Docker Compose sets redis://redis:6379/0 automatically.
# Local dev: redis://localhost:6379/0

# ─── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── QuickBooks (Intuit Developer) ─────────────────────────────────────────
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_REDIRECT_URI=https://gentletap.co/v1/quickbooks/callback
INTUIT_ENVIRONMENT=sandbox
INTUIT_WEBHOOK_VERIFIER_TOKEN=

# ─── Google Gmail OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gentletap.co/v1/google/callback

# ─── Resend ────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# ─── OpenAI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ─── Stripe (Option B pricing tiers) ───────────────────────────────────────
# Create Products + recurring Prices in Stripe Dashboard, then paste Price IDs:
STRIPE_PRICE_ID_PRO=                    # legacy alias for Pro monthly
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_ANNUAL=
STRIPE_PRICE_ID_PRO_PLUS_MONTHLY=
STRIPE_PRICE_ID_PRO_PLUS_ANNUAL=
STRIPE_PRICE_ID_TEAM_MONTHLY=
STRIPE_PRICE_ID_TEAM_ANNUAL=
OPENAI_MODEL_PRIORITY=gpt-4o

# ─── Twilio WhatsApp (Pro+ — Meta-approved Content Templates) ───────────────
# 1. Create templates in Twilio Content Template Builder (copy from templates.py)
# 2. Submit for Meta/WhatsApp approval (typically 24–72 hours)
# 3. Paste approved Content SIDs (HX...) below
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID_GENTLE=
TWILIO_WHATSAPP_CONTENT_SID_FOLLOW_UP=
TWILIO_WHATSAPP_CONTENT_SID_FINAL=

# ─── Observability (optional) ──────────────────────────────────────────────
SENTRY_DSN=

# ─── Docker Compose sets API_PROXY_URL=http://api:8000 for the web service ─
# Do NOT override API_PROXY_URL in .env with https://gentletap.co or localhost.

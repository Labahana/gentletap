# GentleTap environment template
# Copy to .env and fill in values. Never commit .env (gitignored).
#
# Generate secrets:
#   openssl rand -hex 32
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ─── App (public URLs — use https:// in production) ────────────────────────
ENVIRONMENT=production
API_URL=https://gentletap.co
WEB_URL=https://gentletap.co
CORS_ORIGINS=https://gentletap.co,https://www.gentletap.co

SECRET_KEY=change-me-use-openssl-rand-hex-32
# Required when ENVIRONMENT=production (app refuses dev defaults at startup)
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32-min-32-chars
TOKEN_ENCRYPTION_KEY=change-me-32-byte-base64-fernet-key

# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# Simple setup (fresh/empty DB): one Direct connection on port 5432 is enough.
# Copy from Supabase → Database → Connection string → Direct → URI, then:
#   postgresql://  →  postgresql+psycopg2://
#   add  ?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require

# Optional: separate URL for Alembic (only if DATABASE_URL uses transaction pooler :6543)
# DATABASE_MIGRATIONS_URL=postgresql+psycopg2://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require

# Skip auto-migrations on container start (set true after schema exists, or if you run Alembic manually)
SKIP_DB_MIGRATIONS=true

# One-time schema setup on empty DB (run once, then keep SKIP_DB_MIGRATIONS=true):
#   docker compose run --rm api alembic upgrade head

# Local dev: docker-compose.dev.yml overrides DATABASE_URL to local postgres

# ─── Redis / Celery ────────────────────────────────────────────────────────
# Set automatically in production docker-compose.yml — override only if needed
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── JWT / auth ────────────────────────────────────────────────────────────
# JWT_SECRET_KEY is set above with SECRET_KEY — do not use dev defaults in production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── QuickBooks (Intuit Developer) ─────────────────────────────────────────
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_REDIRECT_URI=https://gentletap.co/v1/quickbooks/callback
INTUIT_ENVIRONMENT=sandbox
INTUIT_WEBHOOK_VERIFIER_TOKEN=

# ─── Google Gmail OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gentletap.co/v1/google/callback
# Sign-up / login (add this URI in Google Cloud Console → Authorized redirect URIs)
GOOGLE_AUTH_REDIRECT_URI=https://gentletap.co/v1/auth/google/callback

# ─── Resend (custom domain email) ──────────────────────────────────────────
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# From address for password-reset emails (must be a verified Resend domain)
AUTH_EMAIL_FROM=GentleTap <noreply@gentletap.co>

# ─── OpenAI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_PRIORITY=gpt-4o

# ─── Paddle Billing (Option B pricing) ───────────────────────────────────────
# Sandbox: https://sandbox-vendors.paddle.com — API key + webhook secret from Notifications
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRICE_ID_PRO=
PADDLE_PRICE_ID_PRO_MONTHLY=
PADDLE_PRICE_ID_PRO_ANNUAL=
PADDLE_PRICE_ID_PRO_PLUS_MONTHLY=
PADDLE_PRICE_ID_PRO_PLUS_ANNUAL=
PADDLE_PRICE_ID_TEAM_MONTHLY=
PADDLE_PRICE_ID_TEAM_ANNUAL=
# One-time WhatsApp message packs (optional — buy-more in Connections)
PADDLE_PRICE_ID_WHATSAPP_250=
PADDLE_PRICE_ID_WHATSAPP_500=
# Webhook URL: {API_URL}/v1/webhooks/paddle

# ─── Twilio WhatsApp (Pro+ — Meta-approved templates) ─────────────────────
# Template text: apps/api/gentletap/integrations/twilio/templates.py
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID_GENTLE=
TWILIO_WHATSAPP_CONTENT_SID_FOLLOW_UP=
TWILIO_WHATSAPP_CONTENT_SID_FINAL=

# Dev only: mark own-number connections active without Twilio sender registration
# WHATSAPP_OWN_AUTO_ACTIVATE=true

# Meta Embedded Signup (own business number — Twilio Tech Provider / ISV)
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_PARTNER_SOLUTION_ID=
# TWILIO_USE_SUBACCOUNTS=true
# Subscribe Resend webhooks to: email.sent, email.delivered, email.opened, email.bounced, email.complained

# Shared number: set inbound webhook in Twilio Console to:
#   {API_URL}/v1/webhooks/twilio/whatsapp

# ─── Plans (optional) ──────────────────────────────────────────────────────
# FREE_PLAN_MONTHLY_COLLECTION_LIMIT=5

# ─── Observability (optional) ──────────────────────────────────────────────
SENTRY_DSN=

# ─── Web container (set by docker-compose.yml — do not override in .env) ───
# API_PROXY_URL=http://api:8000

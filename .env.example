# Copy to .env (never commit). VPS: use production block. Local: use development block.

# --- Production (gentletap.co) ---
ENVIRONMENT=production
API_URL=https://gentletap.co
WEB_URL=https://gentletap.co
CORS_ORIGINS=https://gentletap.co,https://www.gentletap.co

SECRET_KEY=
JWT_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

POSTGRES_USER=gentletap
POSTGRES_PASSWORD=choose-a-strong-password
POSTGRES_DB=gentletap
DATABASE_URL=postgresql+psycopg2://gentletap:choose-a-strong-password@postgres:5432/gentletap
# Tune per process (api + each worker). With PgBouncer/Supabase pooler, keep totals under provider limits.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
# Cap Kimi/z.ai calls per minute across all workers (0 = unlimited).
AI_RATE_LIMIT_PER_MINUTE=60

# Platform admin (superadmin allowlist). Comma-separated; leave empty to disable /admin.
ADMIN_EMAILS=
# Optional: restrict admin API to these IPs (comma-separated). Empty = no IP filter.
ADMIN_IP_ALLOWLIST=

# Affiliate program
AFFILIATE_DEFAULT_COMMISSION_RATE=0.30
AFFILIATE_COOKIE_DAYS=30
# Recurring commission duration per referred customer (months from first payment).
AFFILIATE_COMMISSION_MONTHS=12

# Production with Supabase: use the pooler connection string (port 6543) and keep
# (api workers × DB_POOL_SIZE) + (celery workers × concurrency × DB_POOL_SIZE) under your plan limit.
DATABASE_MIGRATIONS_URL=
SKIP_DB_MIGRATIONS=false

# Redis + Celery (required for QB sync, reminders, WhatsApp follow-ups)
# Docker VPS: use host "redis" (service name). Never use localhost inside containers.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_REDIRECT_URI=https://gentletap.co/v1/quickbooks/callback
INTUIT_ENVIRONMENT=sandbox
INTUIT_WEBHOOK_VERIFIER_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gentletap.co/v1/google/callback
GOOGLE_AUTH_REDIRECT_URI=https://gentletap.co/v1/auth/google/callback

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Shared platform sender for onboarding (requires Resend)
PLATFORM_EMAIL_ADDRESS=accounts@notify.gentletap.co
AUTH_EMAIL_FROM=GentleTap <noreply@gentletap.co>

KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_MODEL_PRIORITY=kimi-k2.6

# z.ai (Zhipu / GLM) — OpenAI-compatible AI fallback used when Kimi is unavailable.
ZAI_API_KEY=
ZAI_MODEL=glm-4.7-flash
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/

PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Publishable client-side token (Paddle → Developer Tools → Authentication → Client-side tokens).
# Safe to expose; enables the Paddle.js overlay checkout. Leave empty to use hosted-link checkout.
PADDLE_CLIENT_TOKEN=
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRICE_ID_PRO=
PADDLE_PRICE_ID_PRO_MONTHLY=
PADDLE_PRICE_ID_PRO_ANNUAL=
PADDLE_PRICE_ID_PRO_PLUS_MONTHLY=
PADDLE_PRICE_ID_PRO_PLUS_ANNUAL=
PADDLE_PRICE_ID_TEAM_MONTHLY=
PADDLE_PRICE_ID_TEAM_ANNUAL=
PADDLE_PRICE_ID_WHATSAPP_250=
PADDLE_PRICE_ID_WHATSAPP_500=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Production: register one WhatsApp sender in Twilio Console (Messaging → Senders).
# Sandbox: whatsapp:+14155238886 — join from each test phone in Twilio sandbox.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Content Template SIDs (HX...) from Twilio Content Template Builder after Meta approval.
# Submit exact copy from apps/api/gentletap/integrations/twilio/templates.py
TWILIO_WHATSAPP_CONTENT_SID_GENTLE=
TWILIO_WHATSAPP_CONTENT_SID_FOLLOW_UP=
TWILIO_WHATSAPP_CONTENT_SID_FINAL=
# Twilio Console webhooks for the shared sender:
#   Inbound: {API_URL}/v1/webhooks/twilio/whatsapp
#   Status:  {API_URL}/v1/webhooks/twilio/whatsapp/status

FREE_PLAN_MONTHLY_COLLECTION_LIMIT=5
SENTRY_DSN=

# Legal entity (must match Paddle seller account — baked into web build)
NEXT_PUBLIC_LEGAL_ENTITY_NAME=GentleTap
NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS=Nigeria

# --- Local development (replace production block above) ---

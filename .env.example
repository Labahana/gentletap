# ─── App ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
API_URL=http://localhost:8000
WEB_URL=http://localhost:3000
SECRET_KEY=change-me-use-openssl-rand-hex-32
TOKEN_ENCRYPTION_KEY=change-me-32-byte-base64-fernet-key

# ─── Database (local Docker) ───────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://gentletap:gentletap@localhost:5433/gentletap

# ─── Redis (local Docker) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── QuickBooks (Intuit Developer) ─────────────────────────────────────────
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_REDIRECT_URI=http://localhost:8000/v1/quickbooks/callback
INTUIT_ENVIRONMENT=sandbox

# ─── Google Gmail OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/google/callback

# ─── Resend ────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── OpenAI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# ─── Next.js (public) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

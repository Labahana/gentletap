# Copy to .env (never commit). VPS: use production block. Local: use development block.

# --- Production (gentletap.co) ---
ENVIRONMENT=production
API_URL=https://gentletap.co
WEB_URL=https://gentletap.co
CORS_ORIGINS=https://gentletap.co,https://www.gentletap.co

SECRET_KEY=
JWT_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=

POSTGRES_USER=gentletap
POSTGRES_PASSWORD=choose-a-strong-password
POSTGRES_DB=gentletap
DATABASE_URL=postgresql+psycopg2://gentletap:choose-a-strong-password@postgres:5432/gentletap
DATABASE_MIGRATIONS_URL=
SKIP_DB_MIGRATIONS=false

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_REDIRECT_URI=https://gentletap.co/v1/quickbooks/callback
INTUIT_ENVIRONMENT=sandbox
INTUIT_WEBHOOK_VERIFIER_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gentletap.co/v1/google/callback
GOOGLE_AUTH_REDIRECT_URI=https://gentletap.co/v1/auth/google/callback

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
AUTH_EMAIL_FROM=GentleTap <noreply@gentletap.co>

KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_MODEL_PRIORITY=kimi-k2.6

PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRICE_ID_PRO=
PADDLE_PRICE_ID_PRO_MONTHLY=
PADDLE_PRICE_ID_PRO_ANNUAL=
PADDLE_PRICE_ID_PRO_PLUS_MONTHLY=
PADDLE_PRICE_ID_PRO_PLUS_ANNUAL=
PADDLE_PRICE_ID_TEAM_MONTHLY=
PADDLE_PRICE_ID_TEAM_ANNUAL=
PADDLE_PRICE_ID_WHATSAPP_250=
PADDLE_PRICE_ID_WHATSAPP_500=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Production: register one WhatsApp sender in Twilio Console (Messaging → Senders).
# Sandbox: whatsapp:+14155238886 — join from each test phone in Twilio sandbox.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Content Template SIDs (HX...) from Twilio Content Template Builder after Meta approval.
# Submit exact copy from apps/api/gentletap/integrations/twilio/templates.py
TWILIO_WHATSAPP_CONTENT_SID_GENTLE=
TWILIO_WHATSAPP_CONTENT_SID_FOLLOW_UP=
TWILIO_WHATSAPP_CONTENT_SID_FINAL=
# Twilio Console webhooks for the shared sender:
#   Inbound: {API_URL}/v1/webhooks/twilio/whatsapp
#   Status:  {API_URL}/v1/webhooks/twilio/whatsapp/status

FREE_PLAN_MONTHLY_COLLECTION_LIMIT=5
SENTRY_DSN=

# --- Local development (replace production block above) ---
# ENVIRONMENT=development
# API_URL=http://localhost:8000
# WEB_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DATABASE_URL=postgresql+psycopg2://gentletap:gentletap@localhost:5433/gentletap
# SKIP_DB_MIGRATIONS=false
# INTUIT_REDIRECT_URI=http://localhost:8000/v1/quickbooks/callback
# GOOGLE_REDIRECT_URI=http://localhost:8000/v1/google/callback
# GOOGLE_AUTH_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

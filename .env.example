ENVIRONMENT=production
API_URL=https://gentletap.co
WEB_URL=https://gentletap.co
CORS_ORIGINS=["https://gentletap.co","https://www.gentletap.co","http://localhost:3000"]

# Legal (baked into web build — must match Paddle seller)
VITE_LEGAL_ENTITY_NAME=GentleTap
VITE_LEGAL_ENTITY_ADDRESS=Nigeria

# Secrets (required in production — no dev defaults)
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
TOKEN_ENCRYPTION_KEY=your_base64_token_encryption_key_here
# Admin API key for X-Admin-Api-Key header auth on /admin/* + /affiliates/admin/*
ADMIN_API_KEY=your_strong_admin_api_key_here

# Webhook verification (all fail-closed when empty)
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret_here
INTUIT_WEBHOOK_VERIFIER_TOKEN=your_intuit_verifier_token_here
FRESHBOOKS_WEBHOOK_VERIFIER_TOKEN=your_freshbooks_webhook_verifier_token_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Database
POSTGRES_USER=gentletap
POSTGRES_PASSWORD=gentletap_postgres_password
POSTGRES_DB=gentletap
DATABASE_URL=postgresql+psycopg2://gentletap:gentletap_postgres_password@postgres:5432/gentletap
DATABASE_MIGRATIONS_URL=
SKIP_DB_MIGRATIONS=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
AI_RATE_LIMIT_PER_MINUTE=60

# Redis + Celery
REDIS_PASSWORD=choose-a-strong-redis-password
REDIS_URL=redis://:choose-a-strong-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:choose-a-strong-redis-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:choose-a-strong-redis-password@redis:6379/1

# Auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# QuickBooks
INTUIT_CLIENT_ID=your_intuit_client_id_here
INTUIT_CLIENT_SECRET=your_intuit_client_secret_here
INTUIT_REDIRECT_URI=https://gentletap.co/v1/quickbooks/callback
INTUIT_ENVIRONMENT=production
INTUIT_WEBHOOK_VERIFIER_TOKEN=your_intuit_webhook_verifier_token_here

# FreshBooks
FRESHBOOKS_CLIENT_ID=your_freshbooks_client_id_here
FRESHBOOKS_CLIENT_SECRET=your_freshbooks_client_secret_here
FRESHBOOKS_REDIRECT_URI=https://gentletap.co/v1/freshbooks/callback

# Google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://gentletap.co/v1/google/callback
GOOGLE_AUTH_REDIRECT_URI=https://gentletap.co/v1/auth/google/callback

# Resend
RESEND_API_KEY=your_resend_api_key_here
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret_here
AUTH_EMAIL_FROM=GentleTap <noreply@gentletap.co>
PLATFORM_EMAIL_ADDRESS=accounts@notify.gentletap.co

# AI (Kimi primary, z.ai fallback)
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_MODEL_PRIORITY=kimi-k2.6
ZAI_API_KEY=your_zai_api_key_here
ZAI_MODEL=glm-4.7-flash
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/

# OpenAI (legacy — not used by current code)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_PRIORITY=gpt-4o

# Paddle
PADDLE_API_KEY=your_paddle_api_key_here
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret_here
PADDLE_ENVIRONMENT=production
PADDLE_PRICE_ID_PRO=your_paddle_price_id_here
PADDLE_PRICE_ID_PRO_MONTHLY=your_paddle_price_id_here
PADDLE_PRICE_ID_PRO_ANNUAL=your_paddle_price_id_here
PADDLE_PRICE_ID_PRO_PLUS_MONTHLY=your_paddle_price_id_here
PADDLE_PRICE_ID_PRO_PLUS_ANNUAL=your_paddle_price_id_here
PADDLE_PRICE_ID_TEAM_MONTHLY=your_paddle_price_id_here
PADDLE_PRICE_ID_TEAM_ANNUAL=your_paddle_price_id_here
PADDLE_PRICE_ID_WHATSAPP_250=your_paddle_price_id_here
PADDLE_PRICE_ID_WHATSAPP_500=your_paddle_price_id_here

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID_GENTLE=
TWILIO_WHATSAPP_CONTENT_SID_FOLLOW_UP=
TWILIO_WHATSAPP_CONTENT_SID_FINAL=
TWILIO_USE_SUBACCOUNTS=true
WHATSAPP_OWN_AUTO_ACTIVATE=false

# Meta (embedded signup / own number)
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_PARTNER_SOLUTION_ID=

# Affiliates
AFFILIATE_DEFAULT_COMMISSION_RATE=0.30
AFFILIATE_COOKIE_DAYS=30
AFFILIATE_COMMISSION_MONTHS=24
AFFILIATE_REFERRAL_DISCOUNT_PERCENT=0.20
AFFILIATE_REFERRAL_DISCOUNT_MONTHS=3
PADDLE_DISCOUNT_ID_AFFILIATE_REFERRAL=your_paddle_discount_id_here

# Plans
FREE_PLAN_MONTHLY_COLLECTION_LIMIT=5

# Admin
ADMIN_EMAILS=["admin@example.com"]
ADMIN_IP_ALLOWLIST=[]
TRUST_PROXY_HEADERS=true

# Optional
SENTRY_DSN=
API_PROXY_URL=http://api:8000
